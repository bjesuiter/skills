{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {"type": "string"},
    "ranking": {"type": "array", "items": {"type": "string"}},
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {"type": "string"},
          "brief_compliance": {"type": "integer", "minimum": 0, "maximum": 20},
          "visual_craft": {"type": "integer", "minimum": 0, "maximum": 25},
          "geometry_scaling": {"type": "integer", "minimum": 0, "maximum": 15},
          "accessibility_integration": {"type": "integer", "minimum": 0, "maximum": 15},
          "maintainability": {"type": "integer", "minimum": 0, "maximum": 15},
          "safety_robustness": {"type": "integer", "minimum": 0, "maximum": 10},
          "total": {"type": "integer", "minimum": 0, "maximum": 100},
          "strengths": {"type": "array", "items": {"type": "string"}},
          "weaknesses": {"type": "array", "items": {"type": "string"}}
        },
        "required": [
          "label",
          "brief_compliance",
          "visual_craft",
          "geometry_scaling",
          "accessibility_integration",
          "maintainability",
          "safety_robustness",
          "total",
          "strengths",
          "weaknesses"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["verdict", "ranking", "scores"],
  "additionalProperties": false
}
